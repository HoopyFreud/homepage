---
{
  eleventyComputed:{
    navigationOptions: {
      listElement: "ul",
      listItemElement: "li",
      listClass: "flex flex-row w-full h-full gap-2 justify-evenly",
      listItemClass: "flex min-h-10 h-full w-full items-center justify-center rounded-lg px-2",
      listItemHasChildrenClass: "",
      activeListItemClass: "current",
      useAriaCurrentAttr: true,
      activeKey: "{{eleventyNavigation.key}}"
    }
  },
  title: "Mechanist.net"
}
---
<!doctype html>
<html lang="en">
  <head>
		<link rel="icon" href="/assets/img/icon.webp" />
    <link rel="stylesheet" href="/assets/css/main.css">
    <link rel="stylesheet" href="/assets/css/fonts.css">
    <link rel="stylesheet" href="/assets/css/tailwind.css">
    <title>{{ title }}</title>
  </head>
  <body class="dark">
    <div id="site" class="flex flex-col items-center">
      <div id="nav" class="my-10 w-full">
        {{ collections.all | eleventyNavigation | eleventyNavigationToHtml: navigationOptions}}
      </div>
      <div id="content" class="w-3/4">
        {{ content }}
      </div>
    </div>
  </body>
</html>