---
{
  eleventyComputed:{
    navigationOptions: {
      listElement: "ul",
      listItemElement: "li",
      listClass: "",
      listItemClass: "",
      listItemHasChildrenClass: "",
      activeListItemClass: "current",
      useAriaCurrentAttr: true,
      activeKey: "{{eleventyNavigation.key}}"
    }
  },
  title: "Mechanist.net"
}
---
<!doctype html>
<html lang="en">
  <head>
		<link rel="icon" href="/assets/img/icon.webp" />
    <link rel="stylesheet" href="/assets/css/main.css">
    <link rel="stylesheet" href="/assets/css/fonts.css">
    <link rel="stylesheet" href="/assets/css/tailwind.css">
    <title>{{ title }}</title>
  </head>
  <body class="dark">
    <div id="site">
      <div id="nav">
        {{ collections.all | eleventyNavigation | eleventyNavigationToHtml: navigationOptions}}
        {{ content }}
      </div>
    </div>
  </body>
</html>